{
  "info": {
    "_postman_id": "aaae8773-2164-4459-a21a-ee5750bbf68d",
    "name": "AI Data Migration – Airtable API",
    "description": "Airtable and HubSpot REST API requests used to test the AI Data Migration Assistant: list records, create a record, and delete a record in Airtable, and list contacts in HubSpot. Set base_id, token and hubspot_token as Postman environment variables; record_id is the id of the record to delete.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "58841448"
  },
  "item": [
    {
      "name": "List records",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://api.airtable.com/v0/{{base_id}}/Bookings",
          "protocol": "https",
          "host": [
            "api",
            "airtable",
            "com"
          ],
          "path": [
            "v0",
            "{{base_id}}",
            "Bookings"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Create record",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "   {\r\n     \"records\": [\r\n       {\r\n         \"fields\": {\r\n           \"customer_name\": \"Postman Test\",\r\n           \"email\": \"test@example.com\",\r\n           \"phone\": \"+971501234567\",\r\n           \"destination\": \"Paris\",\r\n           \"booking_date\": \"2026-10-01\",\r\n           \"travel_date\": \"2026-11-01\",\r\n           \"amount_aed\": 1200,\r\n           \"status\": \"Confirmed\"\r\n         }\r\n       }\r\n     ]\r\n   }",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "https://api.airtable.com/v0/{{base_id}}/Bookings",
          "protocol": "https",
          "host": [
            "api",
            "airtable",
            "com"
          ],
          "path": [
            "v0",
            "{{base_id}}",
            "Bookings"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Delete Record",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "https://api.airtable.com/v0/{{base_id}}/Bookings/{{record_id}}",
          "protocol": "https",
          "host": [
            "api",
            "airtable",
            "com"
          ],
          "path": [
            "v0",
            "{{base_id}}",
            "Bookings",
            "{{record_id}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "HubSpot – List contacts",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{hubspot_token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://api.hubapi.com/crm/v3/objects/contacts?limit=5&properties=lastname,email,phone,destination,booked_on,travel_dt,price,booking_status",
          "protocol": "https",
          "host": [
            "api",
            "hubapi",
            "com"
          ],
          "path": [
            "crm",
            "v3",
            "objects",
            "contacts"
          ],
          "query": [
            {
              "key": "limit",
              "value": "5"
            },
            {
              "key": "properties",
              "value": "lastname,email,phone,destination,booked_on,travel_dt,price,booking_status"
            }
          ]
        }
      },
      "response": []
    }
  ]
}